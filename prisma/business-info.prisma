model BusinessInfo {
    id                      String          @id     @default(uuid())
    name                    String                                          
    representativeName      String                                          
    registrationNumber      String                                          
    address                 String                                          
    contactNumber           String                                          
    email                   String                                          

    createdAt               DateTime        @default(now())
    updatedAt               DateTime        @default(now()) @updatedAt
}
