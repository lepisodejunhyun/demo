{
  "compileOnSave": false,
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@api-client": ["libs/api-client/src/lib/index.ts"],
      "@api-client-shop": ["libs/api-client-shop/src/lib/index.ts"],
      "@org/shared/ui": ["./libs/shared/ui/src/index.ts"],
      "@org/shared/utils": ["./libs/shared/utils/src/index.ts"],
      "@org/api/pagination": ["./libs/api/pagination/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
