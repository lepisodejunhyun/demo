model SocialAccount {
    id              String          @id     @default(uuid())
    memberId        String
    member          Member          @relation(fields: [memberId], references: [id])
    provider        AuthProvider                                
    providerId      String                                      
    createdAt       DateTime        @default(now())
    @@unique([provider, providerId])                            
}

enum AuthProvider {
    KAKAO
}
