model Terms {
    id              String          @id     @default(uuid())
    title           String                               
    content         String                               
    isRequired      Boolean         @default(true)
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @default(now()) @updatedAt
    deletedAt       DateTime?

    @@index([deletedAt, createdAt])

    agreements      TermsAgreement[]
}
