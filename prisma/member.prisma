model Member {
    id              String          @id     @default(uuid())
    email           String          @unique
    password        String?                                         
    name            String
    socialAccounts  SocialAccount[]                                
    inquiries       Inquiry[]
    preRegistrations PreRegistration[]                             
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @default(now()) @updatedAt
    deletedAt       DateTime?
}
